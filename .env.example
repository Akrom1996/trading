# Telegram Notifications
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_ERROR_CHAT_ID=-1001234567890

# Binance API Credentials
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true
DRY_RUN=true

# Trading Execution Parameters
SYMBOL=SOL/USDT
ROLE=coin_trader
QUOTE_AMOUNT_PER_TRADE=20.0
ENTRY_OFFSET_PCT=0.003
SL_COOLDOWN_MINUTES=30.0
TP_COOLDOWN_MINUTES=10.0
MAX_TRADES_PER_DAY=10
MAX_RISK_PER_TRADE=0.02
MAX_DAILY_LOSS=6.0

# Profit Lock / Breakeven Protection
PROFIT_LOCK_TRIGGER_PCT=0.01
PROFIT_LOCK_SL_PCT=0.01
BTC_FILTER_ENABLED=false

# Model & Candle Data
TRAIN_CANDLES=2880
LIVE_CANDLES=1000
MAX_MODEL_AGE_HRS=12
MAX_PYRAMID_POSITIONS=6
PYRAMID_TRIGGER_PCT=0.002
PENDING_FILL_TIMEOUT_MINUTES=15

# Storage & Infrastructure
DB_PATH=/app/data/bot_data.db
REDIS_URL=redis://redis:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
STATE_DIR=/app/state

